#!/bin/bash
# Stremio+ CLI wrapper (macOS / Linux). The CLI itself is cli/index.js; run `stremio-plus help` for commands.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
NODE="$ROOT/runtime/node/bin/node"
[[ -x "$NODE" ]] || NODE="$(command -v node || true)"
if [[ -z "$NODE" ]]; then echo "Stremio+ needs Node.js 20+ (https://nodejs.org) or a reinstall" >&2; exit 1; fi
exec "$NODE" "$ROOT/cli/index.js" "$@"
