#!/bin/bash
# stremio-plus: Spicetify-style helper for the Stremio+ build.
#   stremio-plus launch    start the server (if needed) and open Stremio with the modded UI
#   stremio-plus build     rebuild the modded UI (web/) into web/build
#   stremio-plus apply     build, restart the server, relaunch Stremio
#   stremio-plus start     start the server (addon :7010 + UI :7011)
#   stremio-plus stop      stop the server
#   stremio-plus restart   restart the server
#   stremio-plus test      screenshot the UI in headless Brave (tools/ui-test)
#   stremio-plus vanilla   reopen Stremio with its normal UI (auto-mod pauses until next launch)
#   stremio-plus logs      follow the server log
#   stremio-plus enable    install the login agent: server always on, Stremio always opens modded
#   stremio-plus disable   remove the login agent
#   stremio-plus daemon    (run by the agent) keep the server up, re-open stock Stremio with the mods
set -euo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ADDON="$ROOT/addon"
WEB="$ROOT/web"
LOG="$ADDON/data/server.log"
UI_URL="http://127.0.0.1:7011/"
STREMIO_BIN="/Applications/Stremio.app/Contents/MacOS/Stremio"
VANILLA_FLAG="$ADDON/data/.vanilla"
CHROME_SRC="$ROOT/shell/chrome.m"
CHROME_LIB="$ROOT/shell/build/libstremio-plus-chrome.dylib"
AGENT_LABEL="com.stremio-plus.agent"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

running() { curl -s -o /dev/null --max-time 2 http://127.0.0.1:7010/manifest.json; }

start() {
  if running; then echo "server already running"; return; fi
  mkdir -p "$ADDON/data"
  (cd "$ADDON" && nohup node server.js >> "$LOG" 2>&1 &)
  for _ in $(seq 1 30); do running && { echo "server started (addon :7010, UI :7011)"; return; }; sleep 0.2; done
  echo "server failed to start; see $LOG" >&2; exit 1
}

stop() { pkill -f "node server.js" && echo "server stopped" || echo "server not running"; }

build() {
  (cd "$WEB" && SERVICE_WORKER_DISABLED=true npx webpack --mode production 2>&1 | grep -E "ERROR|Module not found|compiled")
}

# Window chrome dylib (transparent title bar, traffic lights in the nav bar), injected with DYLD_INSERT_LIBRARIES.
build_chrome() {
  if [[ ! -f "$CHROME_LIB" || "$CHROME_SRC" -nt "$CHROME_LIB" ]]; then
    mkdir -p "$(dirname "$CHROME_LIB")"
    xcrun clang -dynamiclib -fobjc-arc -arch arm64 -mmacosx-version-min=11.0 -framework Cocoa -framework WebKit -framework MediaPlayer \
      -o "$CHROME_LIB" "$CHROME_SRC" && codesign -f -s - "$CHROME_LIB" >/dev/null 2>&1 \
      || { echo "chrome dylib build failed; launching without it" >&2; rm -f "$CHROME_LIB"; }
  fi
}

open_modded() {
  build_chrome
  if [[ -f "$CHROME_LIB" ]]; then
    open -a Stremio --env "DYLD_INSERT_LIBRARIES=$CHROME_LIB" --args "--webui-url=$UI_URL"
  else
    open -a Stremio --args "--webui-url=$UI_URL"
  fi
}

quit_stremio() {
  if pgrep -f "$STREMIO_BIN" >/dev/null; then
    osascript -e 'quit app "Stremio"' || true
    for _ in $(seq 1 40); do pgrep -f "$STREMIO_BIN" >/dev/null || break; sleep 0.25; done
  fi
}

launch() {
  rm -f "$VANILLA_FLAG"
  start
  if pgrep -f -- "--webui-url=$UI_URL" >/dev/null; then
    open -a Stremio
  else
    quit_stremio
    open_modded
  fi
}

# pid of a Stremio started without the modded UI (age < 20s), if any
stock_stremio_pid() {
  local pid args age
  for pid in $(pgrep -f "^$STREMIO_BIN" || true); do
    args="$(ps -o args= -p "$pid" 2>/dev/null || true)"
    [[ "$args" == "$STREMIO_BIN"* ]] || continue
    [[ "$args" == *"--webui-url"* ]] && continue
    age="$(ps -o etime= -p "$pid" | tr -d ' ')"
    [[ "$age" =~ ^(00:)?[0-1][0-9]$ ]] || continue
    echo "$pid"; return
  done
}

# Quit the stock instance, wait until it has fully exited, then open the modded one. LaunchServices refuses
# to open an app that is still shutting down (error -600), so retry instead of failing.
reopen_modded() {
  local pid="$1" attempt
  osascript -e 'quit app "Stremio"' >/dev/null 2>&1 || true
  for _ in $(seq 1 60); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
  kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null
  sleep 0.5
  for attempt in 1 2 3 4 5 6; do
    if open_modded; then
      echo "$(date '+%F %T') reopened with the mods (attempt $attempt)"
      return 0
    fi
    sleep 1
  done
  echo "$(date '+%F %T') could not reopen Stremio"
}

daemon() {
  set +e  # a failed step must never stop the agent (launchd would restart it and kill the server with it)
  echo "$(date '+%F %T') agent started"
  local pid self="${BASH_SOURCE[0]}" stamp
  stamp="$(stat -f %m "$self")"
  while true; do
    # bash keeps the functions it loaded at start, so a long-running agent would keep reopening Stremio with
    # stale launch code (e.g. without the chrome dylib). Re-exec when this script changes.
    if [[ "$(stat -f %m "$self" 2>/dev/null)" != "$stamp" ]]; then
      echo "$(date '+%F %T') script changed; reloading agent"
      exec /bin/bash "$self" daemon
    fi
    running || start
    if [[ ! -f "$VANILLA_FLAG" ]]; then
      pid="$(stock_stremio_pid)"
      if [[ -n "$pid" ]]; then
        echo "$(date '+%F %T') stock Stremio opened (pid $pid); reopening with the mods"
        reopen_modded "$pid"
        sleep 5
      fi
    fi
    sleep 1
  done
}

enable() {
  mkdir -p "$ADDON/data" "$(dirname "$AGENT_PLIST")"
  cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key><array><string>$ROOT/bin/stremio-plus</string><string>daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>$ADDON/data/agent.log</string>
  <key>StandardErrorPath</key><string>$ADDON/data/agent.log</string>
</dict></plist>
PLIST
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
  echo "agent enabled: server runs at login, Stremio always opens with the mods"
}

disable() {
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  rm -f "$AGENT_PLIST"
  echo "agent disabled"
}

case "${1:-launch}" in
  launch) launch ;;
  build) build ;;
  apply) build; build_chrome; stop; start; quit_stremio; launch ;;
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.5; start ;;
  test) start; (cd "$ROOT/tools/ui-test" && node test.js "${2:-all}") ;;
  vanilla) mkdir -p "$ADDON/data"; touch "$VANILLA_FLAG"; quit_stremio; open -a Stremio ;;
  daemon) daemon ;;
  enable) enable ;;
  disable) disable ;;
  logs) tail -f "$LOG" ;;
  *) sed -n '2,15p' "$0"; exit 1 ;;
esac
